# API Configuration
VITE_API_URL=https://localhost:7294/api

# Google OAuth Configuration
# Get your Google Client ID from: https://console.cloud.google.com/
# 1. Create or select a project
# 2. Enable Google+ API (or Google Identity)
# 3. Go to Credentials
# 4. Create OAuth 2.0 Client ID (Web application)
# 5. Add authorized JavaScript origins (e.g., http://localhost:5173)
# 6. Copy the Client ID and paste it below
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
